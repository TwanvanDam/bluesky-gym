{
  "$defs": {
    "ActivationLayerConfig": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "ReLU",
            "Tanh",
            "Sigmoid"
          ],
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "title": "ActivationLayerConfig",
      "type": "object"
    },
    "Clip": {
      "additionalProperties": false,
      "description": "Clip values to ``[0, upper]`` (people/km\u00b2). Applied last; this is the\ncross-resolution consistency mechanism, so keep ``p=1.0``.\n\n``percentile`` \u2014 clip at this percentile of the *base* map (e.g. 99.9), matching\nthe legacy ``map_source_max`` clipping. Call ``resolve(base_array)`` once after\nloading the base raster (handled by TransformedTiffMapSource); the resolved upper\nbound is constant across episodes since the base raster never changes.",
      "properties": {
        "p": {
          "default": 1.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "P",
          "type": "number"
        },
        "type": {
          "const": "clip",
          "default": "clip",
          "title": "Type",
          "type": "string"
        },
        "percentile": {
          "maximum": 100.0,
          "minimum": 0.0,
          "title": "Percentile",
          "type": "number"
        }
      },
      "required": [
        "percentile"
      ],
      "title": "Clip",
      "type": "object"
    },
    "ConvolutionLayerConfig": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "conv",
          "default": "conv",
          "title": "Type",
          "type": "string"
        },
        "in_channels": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "In Channels"
        },
        "out_channels": {
          "title": "Out Channels",
          "type": "integer"
        },
        "kernel_size": {
          "title": "Kernel Size",
          "type": "integer"
        },
        "stride": {
          "title": "Stride",
          "type": "integer"
        },
        "padding": {
          "title": "Padding",
          "type": "integer"
        }
      },
      "required": [
        "out_channels",
        "kernel_size",
        "stride",
        "padding"
      ],
      "title": "ConvolutionLayerConfig",
      "type": "object"
    },
    "DropoutLayerConfig": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "dropout",
          "default": "dropout",
          "title": "Type",
          "type": "string"
        },
        "p": {
          "title": "P",
          "type": "number"
        }
      },
      "required": [
        "p"
      ],
      "title": "DropoutLayerConfig",
      "type": "object"
    },
    "ExclusionZone": {
      "additionalProperties": false,
      "properties": {
        "lat": {
          "title": "Lat",
          "type": "number"
        },
        "lon": {
          "title": "Lon",
          "type": "number"
        },
        "radius_km": {
          "title": "Radius Km",
          "type": "number"
        }
      },
      "required": [
        "lat",
        "lon",
        "radius_km"
      ],
      "title": "ExclusionZone",
      "type": "object"
    },
    "FeatureExtractorConfig": {
      "properties": {
        "cnn_layers": {
          "anyOf": [
            {
              "items": {
                "discriminator": {
                  "mapping": {
                    "ReLU": "#/$defs/ActivationLayerConfig",
                    "Sigmoid": "#/$defs/ActivationLayerConfig",
                    "Tanh": "#/$defs/ActivationLayerConfig",
                    "conv": "#/$defs/ConvolutionLayerConfig",
                    "dropout": "#/$defs/DropoutLayerConfig",
                    "global_pooling": "#/$defs/GlobalPoolingLayerConfig",
                    "linear": "#/$defs/LinearLayerConfig",
                    "pooling": "#/$defs/PoolingLayerConfig"
                  },
                  "propertyName": "type"
                },
                "oneOf": [
                  {
                    "$ref": "#/$defs/ConvolutionLayerConfig"
                  },
                  {
                    "$ref": "#/$defs/GlobalPoolingLayerConfig"
                  },
                  {
                    "$ref": "#/$defs/LinearLayerConfig"
                  },
                  {
                    "$ref": "#/$defs/PoolingLayerConfig"
                  },
                  {
                    "$ref": "#/$defs/ActivationLayerConfig"
                  },
                  {
                    "$ref": "#/$defs/DropoutLayerConfig"
                  }
                ]
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Cnn Layers"
        },
        "vector_layer_sizes": {
          "anyOf": [
            {
              "items": {
                "discriminator": {
                  "mapping": {
                    "ReLU": "#/$defs/ActivationLayerConfig",
                    "Sigmoid": "#/$defs/ActivationLayerConfig",
                    "Tanh": "#/$defs/ActivationLayerConfig",
                    "dropout": "#/$defs/DropoutLayerConfig",
                    "linear": "#/$defs/LinearLayerConfig"
                  },
                  "propertyName": "type"
                },
                "oneOf": [
                  {
                    "$ref": "#/$defs/LinearLayerConfig"
                  },
                  {
                    "$ref": "#/$defs/ActivationLayerConfig"
                  },
                  {
                    "$ref": "#/$defs/DropoutLayerConfig"
                  }
                ]
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vector Layer Sizes"
        }
      },
      "required": [
        "cnn_layers"
      ],
      "title": "FeatureExtractorConfig",
      "type": "object"
    },
    "FixedSamplingConfig": {
      "additionalProperties": false,
      "properties": {
        "distribution": {
          "const": "fixed",
          "default": "fixed",
          "title": "Distribution",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "value"
      ],
      "title": "FixedSamplingConfig",
      "type": "object"
    },
    "Flip": {
      "additionalProperties": false,
      "description": "Mirror the window array, keeping the geographic extent (Affine) unchanged \u2014\na reflection of the field about the window centre.",
      "properties": {
        "p": {
          "default": 1.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "P",
          "type": "number"
        },
        "type": {
          "const": "flip",
          "default": "flip",
          "title": "Type",
          "type": "string"
        },
        "axis": {
          "default": "combination",
          "enum": [
            "ns",
            "ew",
            "combination"
          ],
          "title": "Axis",
          "type": "string"
        }
      },
      "title": "Flip",
      "type": "object"
    },
    "FloorRaise": {
      "additionalProperties": false,
      "properties": {
        "p": {
          "default": 1.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "P",
          "type": "number"
        },
        "type": {
          "const": "floor_raise",
          "default": "floor_raise",
          "title": "Type",
          "type": "string"
        },
        "floor": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Floor",
          "type": "array"
        }
      },
      "required": [
        "floor"
      ],
      "title": "FloorRaise",
      "type": "object"
    },
    "GammaCorrection": {
      "additionalProperties": false,
      "description": "Power law: compress the range of values (lift countryside toward cities).\n\n``percentile`` sets the identity point: the base-map value at this percentile\nis the fixed point of the curve (f(x)=x). Call ``resolve(value)`` with the\nprecomputed people/km\u00b2 value before sampling (handled by TransformedTiffMapSource).",
      "properties": {
        "p": {
          "default": 1.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "P",
          "type": "number"
        },
        "type": {
          "const": "gamma_correction",
          "default": "gamma_correction",
          "title": "Type",
          "type": "string"
        },
        "gamma": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Gamma",
          "type": "array"
        },
        "percentile": {
          "maximum": 100.0,
          "minimum": 0.0,
          "title": "Percentile",
          "type": "number"
        }
      },
      "required": [
        "gamma",
        "percentile"
      ],
      "title": "GammaCorrection",
      "type": "object"
    },
    "GlobalPoolingLayerConfig": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "global_pooling",
          "default": "global_pooling",
          "title": "Type",
          "type": "string"
        },
        "mode": {
          "enum": [
            "max",
            "avg"
          ],
          "title": "Mode",
          "type": "string"
        }
      },
      "required": [
        "mode"
      ],
      "title": "GlobalPoolingLayerConfig",
      "type": "object"
    },
    "InitialConditionsSamplingConfig": {
      "additionalProperties": false,
      "properties": {
        "simulation_bounds_mode": {
          "default": "degrees",
          "enum": [
            "degrees",
            "meters"
          ],
          "title": "Simulation Bounds Mode",
          "type": "string"
        },
        "simulation_bounds_size": {
          "default": 5.0,
          "title": "Simulation Bounds Size",
          "type": "number"
        },
        "destination_lat_sampling": {
          "discriminator": {
            "mapping": {
              "fixed": "#/$defs/FixedSamplingConfig",
              "normal": "#/$defs/NormalSamplingConfig",
              "uniform": "#/$defs/UniformSamplingConfig"
            },
            "propertyName": "distribution"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/NormalSamplingConfig"
            },
            {
              "$ref": "#/$defs/FixedSamplingConfig"
            },
            {
              "$ref": "#/$defs/UniformSamplingConfig"
            }
          ],
          "title": "Destination Lat Sampling"
        },
        "destination_lon_sampling": {
          "discriminator": {
            "mapping": {
              "fixed": "#/$defs/FixedSamplingConfig",
              "normal": "#/$defs/NormalSamplingConfig",
              "uniform": "#/$defs/UniformSamplingConfig"
            },
            "propertyName": "distribution"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/NormalSamplingConfig"
            },
            {
              "$ref": "#/$defs/FixedSamplingConfig"
            },
            {
              "$ref": "#/$defs/UniformSamplingConfig"
            }
          ],
          "title": "Destination Lon Sampling"
        },
        "destination_hdg_sampling": {
          "discriminator": {
            "mapping": {
              "fixed": "#/$defs/FixedSamplingConfig",
              "normal": "#/$defs/NormalSamplingConfig",
              "uniform": "#/$defs/UniformSamplingConfig"
            },
            "propertyName": "distribution"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/NormalSamplingConfig"
            },
            {
              "$ref": "#/$defs/FixedSamplingConfig"
            },
            {
              "$ref": "#/$defs/UniformSamplingConfig"
            }
          ],
          "title": "Destination Hdg Sampling"
        },
        "aircraft_position_mode": {
          "default": "relative",
          "enum": [
            "absolute",
            "relative"
          ],
          "title": "Aircraft Position Mode",
          "type": "string"
        },
        "aircraft_lat_sampling": {
          "discriminator": {
            "mapping": {
              "fixed": "#/$defs/FixedSamplingConfig",
              "normal": "#/$defs/NormalSamplingConfig",
              "uniform": "#/$defs/UniformSamplingConfig"
            },
            "propertyName": "distribution"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/NormalSamplingConfig"
            },
            {
              "$ref": "#/$defs/FixedSamplingConfig"
            },
            {
              "$ref": "#/$defs/UniformSamplingConfig"
            }
          ],
          "title": "Aircraft Lat Sampling"
        },
        "aircraft_lon_sampling": {
          "discriminator": {
            "mapping": {
              "fixed": "#/$defs/FixedSamplingConfig",
              "normal": "#/$defs/NormalSamplingConfig",
              "uniform": "#/$defs/UniformSamplingConfig"
            },
            "propertyName": "distribution"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/NormalSamplingConfig"
            },
            {
              "$ref": "#/$defs/FixedSamplingConfig"
            },
            {
              "$ref": "#/$defs/UniformSamplingConfig"
            }
          ],
          "title": "Aircraft Lon Sampling"
        },
        "exclusion_zones": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/ExclusionZone"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "title": "Exclusion Zones"
        }
      },
      "required": [
        "destination_lat_sampling",
        "destination_lon_sampling",
        "destination_hdg_sampling",
        "aircraft_lat_sampling",
        "aircraft_lon_sampling",
        "exclusion_zones"
      ],
      "title": "InitialConditionsSamplingConfig",
      "type": "object"
    },
    "LinearLayerConfig": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "linear",
          "default": "linear",
          "title": "Type",
          "type": "string"
        },
        "in_features": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "In Features"
        },
        "out_features": {
          "title": "Out Features",
          "type": "integer"
        }
      },
      "required": [
        "out_features"
      ],
      "title": "LinearLayerConfig",
      "type": "object"
    },
    "MapObservationConfig": {
      "additionalProperties": false,
      "properties": {
        "shape": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "integer"
            },
            {
              "type": "integer"
            }
          ],
          "title": "Shape",
          "type": "array"
        },
        "range": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "title": "Range",
          "type": "array"
        },
        "position": {
          "default": "centered",
          "enum": [
            "centered",
            "forward"
          ],
          "title": "Position",
          "type": "string"
        }
      },
      "required": [
        "shape",
        "range"
      ],
      "title": "MapObservationConfig",
      "type": "object"
    },
    "NavigationConfig": {
      "additionalProperties": false,
      "properties": {
        "ac_name": {
          "default": "KL001",
          "title": "Ac Name",
          "type": "string"
        },
        "ac_type": {
          "default": "a320",
          "title": "Ac Type",
          "type": "string"
        },
        "ac_initial_spd": {
          "default": 200,
          "title": "Ac Initial Spd",
          "type": "number"
        },
        "ac_initial_alt": {
          "default": 3000,
          "title": "Ac Initial Alt",
          "type": "number"
        },
        "map_sampling_config": {
          "$ref": "#/$defs/InitialConditionsSamplingConfig"
        },
        "max_steps": {
          "default": 250,
          "title": "Max Steps",
          "type": "integer"
        },
        "sim_dt": {
          "default": 3,
          "title": "Sim Dt",
          "type": "integer"
        },
        "action_time": {
          "default": 60,
          "title": "Action Time",
          "type": "integer"
        },
        "faf_distance": {
          "default": 25,
          "title": "Faf Distance",
          "type": "number"
        },
        "iaf_angle": {
          "default": 60,
          "title": "Iaf Angle",
          "type": "number"
        },
        "iaf_distance": {
          "default": 30,
          "title": "Iaf Distance",
          "type": "number"
        },
        "map_projection_crs": {
          "default": "EPSG:3035",
          "title": "Map Projection Crs",
          "type": "string"
        },
        "use_sin_cos_obs": {
          "default": false,
          "title": "Use Sin Cos Obs",
          "type": "boolean"
        },
        "normalize_distance_obs": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Normalize Distance Obs"
        },
        "max_action_degrees": {
          "default": 180,
          "title": "Max Action Degrees",
          "type": "number"
        },
        "constraint_violation_reward": {
          "default": -1.0,
          "title": "Constraint Violation Reward",
          "type": "number"
        },
        "successful_approach_reward": {
          "default": 50.0,
          "title": "Successful Approach Reward",
          "type": "number"
        },
        "mean_episode_length": {
          "default": 1200,
          "title": "Mean Episode Length",
          "type": "number"
        },
        "clip_reward_min": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Clip Reward Min"
        },
        "clip_reward_max": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Clip Reward Max"
        }
      },
      "required": [
        "map_sampling_config"
      ],
      "title": "NavigationConfig",
      "type": "object"
    },
    "NoiseConfig": {
      "additionalProperties": false,
      "properties": {
        "noise_base_dba": {
          "default": 85,
          "title": "Noise Base Dba",
          "type": "number"
        },
        "noise_cutoff_dba": {
          "default": 55,
          "title": "Noise Cutoff Dba",
          "type": "number"
        },
        "noise_resolution_m": {
          "default": 1000,
          "title": "Noise Resolution M",
          "type": "number"
        },
        "w_0": {
          "default": 1e-12,
          "title": "W 0",
          "type": "number"
        },
        "base_distance": {
          "default": 304.8,
          "title": "Base Distance",
          "type": "number"
        }
      },
      "title": "NoiseConfig",
      "type": "object"
    },
    "NormalSamplingConfig": {
      "additionalProperties": false,
      "properties": {
        "distribution": {
          "const": "normal",
          "default": "normal",
          "title": "Distribution",
          "type": "string"
        },
        "mean": {
          "default": 0,
          "title": "Mean",
          "type": "number"
        },
        "std": {
          "title": "Std",
          "type": "number"
        }
      },
      "required": [
        "std"
      ],
      "title": "NormalSamplingConfig",
      "type": "object"
    },
    "PoolingLayerConfig": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "pooling",
          "default": "pooling",
          "title": "Type",
          "type": "string"
        },
        "mode": {
          "enum": [
            "max",
            "avg"
          ],
          "title": "Mode",
          "type": "string"
        },
        "kernel_size": {
          "title": "Kernel Size",
          "type": "integer"
        },
        "stride": {
          "default": 1,
          "title": "Stride",
          "type": "integer"
        },
        "padding": {
          "default": 0,
          "title": "Padding",
          "type": "integer"
        }
      },
      "required": [
        "mode",
        "kernel_size"
      ],
      "title": "PoolingLayerConfig",
      "type": "object"
    },
    "PopulationConfig": {
      "additionalProperties": false,
      "properties": {
        "noise_model_config": {
          "$ref": "#/$defs/NoiseConfig"
        },
        "map_source_config": {
          "discriminator": {
            "mapping": {
              "cities": "#/$defs/RandomMapSourceConfig",
              "polygon": "#/$defs/RandomMapSourceConfig",
              "population_density": "#/$defs/RandomMapSourceConfig",
              "tiff": "#/$defs/TiffMapSourceConfig",
              "transformed": "#/$defs/TransformedTiffMapSourceConfig",
              "zero": "#/$defs/RandomMapSourceConfig"
            },
            "propertyName": "type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/TiffMapSourceConfig"
            },
            {
              "$ref": "#/$defs/TransformedTiffMapSourceConfig"
            },
            {
              "$ref": "#/$defs/RandomMapSourceConfig"
            }
          ],
          "title": "Map Source Config"
        },
        "map_observation_configs": {
          "items": {
            "$ref": "#/$defs/MapObservationConfig"
          },
          "title": "Map Observation Configs",
          "type": "array"
        },
        "fuel_weight": {
          "default": 0.5,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Fuel Weight",
          "type": "number"
        },
        "resampling": {
          "default": "average",
          "enum": [
            "cubic_spline",
            "average",
            "sum",
            "min",
            "max",
            "bilinear",
            "cubic"
          ],
          "title": "Resampling",
          "type": "string"
        },
        "normalization_percentile": {
          "default": 99.9,
          "maximum": 100.0,
          "minimum": 0.0,
          "title": "Normalization Percentile",
          "type": "number"
        },
        "clip_noise_reward": {
          "default": false,
          "title": "Clip Noise Reward",
          "type": "boolean"
        },
        "observation_normalization": {
          "default": "log",
          "enum": [
            "log",
            "min_max",
            "min-max"
          ],
          "title": "Observation Normalization",
          "type": "string"
        }
      },
      "required": [
        "map_source_config",
        "map_observation_configs"
      ],
      "title": "PopulationConfig",
      "type": "object"
    },
    "RandomMapSourceConfig": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "cities",
            "polygon",
            "population_density",
            "zero"
          ],
          "title": "Type",
          "type": "string"
        },
        "resolution_m": {
          "default": 1000,
          "title": "Resolution M",
          "type": "number"
        },
        "kwargs": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "title": "Kwargs"
        },
        "source_unit": {
          "default": "people_per_pixel",
          "enum": [
            "people_per_pixel",
            "people_per_km2"
          ],
          "title": "Source Unit",
          "type": "string"
        },
        "pool_size": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pool Size"
