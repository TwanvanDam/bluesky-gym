{
  "$defs": {
    "ActivationLayerConfig": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "ReLU",
            "Tanh",
            "Sigmoid"
          ],
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "title": "ActivationLayerConfig",
      "type": "object"
    },
    "ConvolutionLayerConfig": {
      "properties": {
        "type": {
          "const": "conv",
          "default": "conv",
          "title": "Type",
          "type": "string"
        },
        "in_channels": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "In Channels"
        },
        "out_channels": {
          "title": "Out Channels",
          "type": "integer"
        },
        "kernel_size": {
          "title": "Kernel Size",
          "type": "integer"
        },
        "stride": {
          "title": "Stride",
          "type": "integer"
        },
        "padding": {
          "title": "Padding",
          "type": "integer"
        }
      },
      "required": [
        "out_channels",
        "kernel_size",
        "stride",
        "padding"
      ],
      "title": "ConvolutionLayerConfig",
      "type": "object"
    },
    "FeatureExtractorConfig": {
      "properties": {
        "cnn_layers": {
          "items": {
            "discriminator": {
              "mapping": {
                "ReLU": "#/$defs/ActivationLayerConfig",
                "Sigmoid": "#/$defs/ActivationLayerConfig",
                "Tanh": "#/$defs/ActivationLayerConfig",
                "conv": "#/$defs/ConvolutionLayerConfig",
                "global_pooling": "#/$defs/GlobalPoolingLayerConfig",
                "linear": "#/$defs/LinearLayerConfig",
                "pooling": "#/$defs/PoolingLayerConfig"
              },
              "propertyName": "type"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/ConvolutionLayerConfig"
              },
              {
                "$ref": "#/$defs/GlobalPoolingLayerConfig"
              },
              {
                "$ref": "#/$defs/LinearLayerConfig"
              },
              {
                "$ref": "#/$defs/PoolingLayerConfig"
              },
              {
                "$ref": "#/$defs/ActivationLayerConfig"
              }
            ]
          },
          "title": "Cnn Layers",
          "type": "array"
        },
        "vector_layer_sizes": {
          "anyOf": [
            {
              "items": {
                "$ref": "#/$defs/LinearLayerConfig"
              },
              "type": "array"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Vector Layer Sizes"
        }
      },
      "required": [
        "cnn_layers"
      ],
      "title": "FeatureExtractorConfig",
      "type": "object"
    },
    "FixedSamplingConfig": {
      "additionalProperties": false,
      "properties": {
        "distribution": {
          "const": "fixed",
          "default": "fixed",
          "title": "Distribution",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "value"
      ],
      "title": "FixedSamplingConfig",
      "type": "object"
    },
    "GlobalPoolingLayerConfig": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "global_pooling",
          "default": "global_pooling",
          "title": "Type",
          "type": "string"
        },
        "mode": {
          "enum": [
            "max",
            "avg"
          ],
          "title": "Mode",
          "type": "string"
        }
      },
      "required": [
        "mode"
      ],
      "title": "GlobalPoolingLayerConfig",
      "type": "object"
    },
    "LinearLayerConfig": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "linear",
          "default": "linear",
          "title": "Type",
          "type": "string"
        },
        "in_features": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "In Features"
        },
        "out_features": {
          "title": "Out Features",
          "type": "integer"
        }
      },
      "required": [
        "out_features"
      ],
      "title": "LinearLayerConfig",
      "type": "object"
    },
    "NavigationConfig": {
      "additionalProperties": false,
      "properties": {
        "ac_name": {
          "default": "KL001",
          "title": "Ac Name",
          "type": "string"
        },
        "ac_type": {
          "default": "a320",
          "title": "Ac Type",
          "type": "string"
        },
        "ac_initial_spd": {
          "default": 200,
          "title": "Ac Initial Spd",
          "type": "number"
        },
        "ac_initial_alt": {
          "default": 3000,
          "title": "Ac Initial Alt",
          "type": "number"
        },
        "lon_min": {
          "default": 3.0,
          "title": "Lon Min",
          "type": "number"
        },
        "lon_max": {
          "default": 7.5,
          "title": "Lon Max",
          "type": "number"
        },
        "lat_min": {
          "default": 50.5,
          "title": "Lat Min",
          "type": "number"
        },
        "lat_max": {
          "default": 54.0,
          "title": "Lat Max",
          "type": "number"
        },
        "max_steps": {
          "default": 250,
          "title": "Max Steps",
          "type": "integer"
        },
        "sim_dt": {
          "default": 3,
          "title": "Sim Dt",
          "type": "integer"
        },
        "action_time": {
          "default": 60,
          "title": "Action Time",
          "type": "integer"
        },
        "faf_distance": {
          "default": 25,
          "title": "Faf Distance",
          "type": "number"
        },
        "iaf_angle": {
          "default": 60,
          "title": "Iaf Angle",
          "type": "number"
        },
        "iaf_distance": {
          "default": 30,
          "title": "Iaf Distance",
          "type": "number"
        },
        "destination_lat_sampling": {
          "discriminator": {
            "mapping": {
              "fixed": "#/$defs/FixedSamplingConfig",
              "normal": "#/$defs/NormalSamplingConfig",
              "uniform": "#/$defs/UniformSamplingConfig"
            },
            "propertyName": "distribution"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/NormalSamplingConfig"
            },
            {
              "$ref": "#/$defs/FixedSamplingConfig"
            },
            {
              "$ref": "#/$defs/UniformSamplingConfig"
            }
          ],
          "title": "Destination Lat Sampling"
        },
        "destination_lon_sampling": {
          "discriminator": {
            "mapping": {
              "fixed": "#/$defs/FixedSamplingConfig",
              "normal": "#/$defs/NormalSamplingConfig",
              "uniform": "#/$defs/UniformSamplingConfig"
            },
            "propertyName": "distribution"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/NormalSamplingConfig"
            },
            {
              "$ref": "#/$defs/FixedSamplingConfig"
            },
            {
              "$ref": "#/$defs/UniformSamplingConfig"
            }
          ],
          "title": "Destination Lon Sampling"
        },
        "destination_hdg_sampling": {
          "discriminator": {
            "mapping": {
              "fixed": "#/$defs/FixedSamplingConfig",
              "normal": "#/$defs/NormalSamplingConfig",
              "uniform": "#/$defs/UniformSamplingConfig"
            },
            "propertyName": "distribution"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/NormalSamplingConfig"
            },
            {
              "$ref": "#/$defs/FixedSamplingConfig"
            },
            {
              "$ref": "#/$defs/UniformSamplingConfig"
            }
          ],
          "title": "Destination Hdg Sampling"
        },
        "aircraft_lat_sampling": {
          "discriminator": {
            "mapping": {
              "fixed": "#/$defs/FixedSamplingConfig",
              "normal": "#/$defs/NormalSamplingConfig",
              "uniform": "#/$defs/UniformSamplingConfig"
            },
            "propertyName": "distribution"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/NormalSamplingConfig"
            },
            {
              "$ref": "#/$defs/FixedSamplingConfig"
            },
            {
              "$ref": "#/$defs/UniformSamplingConfig"
            }
          ],
          "title": "Aircraft Lat Sampling"
        },
        "aircraft_lon_sampling": {
          "discriminator": {
            "mapping": {
              "fixed": "#/$defs/FixedSamplingConfig",
              "normal": "#/$defs/NormalSamplingConfig",
              "uniform": "#/$defs/UniformSamplingConfig"
            },
            "propertyName": "distribution"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/NormalSamplingConfig"
            },
            {
              "$ref": "#/$defs/FixedSamplingConfig"
            },
            {
              "$ref": "#/$defs/UniformSamplingConfig"
            }
          ],
          "title": "Aircraft Lon Sampling"
        },
        "pygame_crs": {
          "default": "EPSG:3035",
          "title": "Pygame Crs",
          "type": "string"
        },
        "use_sin_cos_obs": {
          "default": false,
          "title": "Use Sin Cos Obs",
          "type": "boolean"
        },
        "normalize_distance_obs": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Normalize Distance Obs"
        },
        "constraint_violation_reward": {
          "default": -1.0,
          "title": "Constraint Violation Reward",
          "type": "number"
        },
        "successful_approach_reward": {
          "default": 50.0,
          "title": "Successful Approach Reward",
          "type": "number"
        },
        "mean_episode_length": {
          "default": 1200,
          "title": "Mean Episode Length",
          "type": "number"
        },
        "total_dense_rewards": {
          "default": 0.25,
          "title": "Total Dense Rewards",
          "type": "number"
        }
      },
      "title": "NavigationConfig",
      "type": "object"
    },
    "NoiseConfig": {
      "additionalProperties": false,
      "properties": {
        "noise_base_dba": {
          "default": 85,
          "title": "Noise Base Dba",
          "type": "number"
        },
        "noise_cutoff_dba": {
          "default": 55,
          "title": "Noise Cutoff Dba",
          "type": "number"
        },
        "noise_resolution_m": {
          "default": 1000,
          "title": "Noise Resolution M",
          "type": "number"
        },
        "w_0": {
          "default": 1e-12,
          "title": "W 0",
          "type": "number"
        },
        "base_distance": {
          "default": 304.8,
          "title": "Base Distance",
          "type": "number"
        }
      },
      "title": "NoiseConfig",
      "type": "object"
    },
    "NormalSamplingConfig": {
      "additionalProperties": false,
      "properties": {
        "distribution": {
          "const": "normal",
          "default": "normal",
          "title": "Distribution",
          "type": "string"
        },
        "mean": {
          "title": "Mean",
          "type": "number"
        },
        "std": {
          "title": "Std",
          "type": "number"
        }
      },
      "required": [
        "mean",
        "std"
      ],
      "title": "NormalSamplingConfig",
      "type": "object"
    },
    "PoolingLayerConfig": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "pooling",
          "default": "pooling",
          "title": "Type",
          "type": "string"
        },
        "mode": {
          "enum": [
            "max",
            "avg"
          ],
          "title": "Mode",
          "type": "string"
        },
        "kernel_size": {
          "title": "Kernel Size",
          "type": "integer"
        },
        "stride": {
          "default": 1,
          "title": "Stride",
          "type": "integer"
        },
        "padding": {
          "default": 0,
          "title": "Padding",
          "type": "integer"
        }
      },
      "required": [
        "mode",
        "kernel_size"
      ],
      "title": "PoolingLayerConfig",
      "type": "object"
    },
    "PopulationConfig": {
      "additionalProperties": false,
      "properties": {
        "noise_model_config": {
          "$ref": "#/$defs/NoiseConfig"
        },
        "map_source_config": {
          "discriminator": {
            "mapping": {
              "cities": "#/$defs/RandomMapSourceConfig",
              "polygon": "#/$defs/RandomMapSourceConfig",
              "population_density": "#/$defs/RandomMapSourceConfig",
              "tiff": "#/$defs/TiffMapSourceConfig",
              "zero": "#/$defs/RandomMapSourceConfig"
            },
            "propertyName": "type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/TiffMapSourceConfig"
            },
            {
              "$ref": "#/$defs/RandomMapSourceConfig"
            }
          ],
          "title": "Map Source Config"
        },
        "observation_shape": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "integer"
              },
              {
                "type": "integer"
              }
            ],
            "type": "array"
          },
          "title": "Observation Shape",
          "type": "array"
        },
        "observation_range": {
          "items": {
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "integer"
              },
              {
                "type": "integer"
              }
            ],
            "type": "array"
          },
          "title": "Observation Range",
          "type": "array"
        },
        "fuel_weight": {
          "default": 0.5,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Fuel Weight",
          "type": "number"
        },
        "resampling": {
          "default": "cubic_spline",
          "enum": [
            "cubic_spline",
            "average",
            "sum",
            "min",
            "max",
            "bilinear",
            "cubic"
          ],
          "title": "Resampling",
          "type": "string"
        },
        "rendering_normalization": {
          "default": "log",
          "enum": [
            "log",
            "min_max",
            "min-max"
          ],
          "title": "Rendering Normalization",
          "type": "string"
        },
        "observation_normalization": {
          "default": "log",
          "enum": [
            "log",
            "min_max",
            "min-max"
          ],
          "title": "Observation Normalization",
          "type": "string"
        }
      },
      "required": [
        "map_source_config"
      ],
      "title": "PopulationConfig",
      "type": "object"
    },
    "RandomMapSourceConfig": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "cities",
            "polygon",
            "population_density",
            "zero"
          ],
          "title": "Type",
          "type": "string"
        },
        "resolution_m": {
          "default": 1000,
          "title": "Resolution M",
          "type": "number"
        },
        "kwargs": {
          "anyOf": [
            {
              "additionalProperties": true,
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "title": "Kwargs"
        },
        "source_unit": {
          "default": "people_per_pixel",
          "enum": [
            "people_per_pixel",
            "people_per_km2"
          ],
          "title": "Source Unit",
          "type": "string"
        },
        "pool_size": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pool Size"
        }
      },
      "required": [
        "type"
      ],
      "title": "RandomMapSourceConfig",
      "type": "object"
    },
    "SB3ModelConfig": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "SB3",
          "default": "SB3",
          "title": "Type",
          "type": "string"
        },
        "algorithm": {
          "const": "SAC",
          "default": "SAC",
          "title": "Algorithm",
          "type": "string"
        },
        "policy": {
          "default": "MultiInputPolicy",
          "enum": [
            "MultiInputPolicy",
            "MlpPolicy",
            "CnnPolicy"
          ],
          "title": "Policy",
          "type": "string"
        },
        "feature_extractor": {
          "$ref": "#/$defs/FeatureExtractorConfig"
        },
        "network_arch": {
          "additionalProperties": {
            "items": {
              "type": "integer"
            },
            "type": "array"
          },
          "propertyNames": {
            "enum": [
              "pi",
              "qf"
            ]
          },
          "title": "Network Arch",
          "type": "object"
        }
      },
      "required": [
        "feature_extractor",
        "network_arch"
      ],
      "title": "SB3ModelConfig",
      "type": "object"
    },
    "TiffMapSourceConfig": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "tiff",
          "default": "tiff",
          "title": "Type",
          "type": "string"
        },
        "file_path": {
          "title": "File Path",
          "type": "string"
        },
        "source_unit": {
          "default": "people_per_pixel",
          "enum": [
            "people_per_pixel",
            "people_per_km2"
          ],
          "title": "Source Unit",
          "type": "string"
        }
      },
      "required": [
        "file_path"
      ],
      "title": "TiffMapSourceConfig",
      "type": "object"
    },
    "TrainingConfig": {
      "additionalProperties": false,
      "properties": {
        "learning_rate": {
          "default": 0.0003,
          "title": "Learning Rate",
          "type": "number"
        },
        "batch_size": {
          "default": 256,
          "title": "Batch Size",
          "type": "integer"
        },
        "buffer_size": {
          "default": 1000000,
          "title": "Buffer Size",
          "type": "integer"
        },
        "total_timesteps": {
          "default": 1000000,
          "title": "Total Timesteps",
          "type": "integer"
        },
        "save_frequency": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": 50000,
          "title": "Save Frequency"
        }
      },
      "title": "TrainingConfig",
      "type": "object"
    },
    "UniformSamplingConfig": {
      "additionalProperties": false,
      "properties": {
        "distribution": {
          "const": "uniform",
          "default": "uniform",
          "title": "Distribution",
          "type": "string"
        },
        "low": {
          "title": "Low",
          "type": "number"
        },
        "high": {
          "title": "High",
          "type": "number"
        }
      },
      "required": [
        "low",
        "high"
      ],
      "title": "UniformSamplingConfig",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "navigation_config": {
      "$ref": "#/$defs/NavigationConfig"
    },
    "agent_config": {
      "$ref": "#/$defs/SB3ModelConfig"
    },
    "training_config": {
      "anyOf": [
        {
          "$ref": "#/$defs/TrainingConfig"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "population_config": {
      "anyOf": [
        {
          "$ref": "#/$defs/PopulationConfig"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "run_name": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Run Name"
    }
  },
  "required": [
    "navigation_config",
    "agent_config"
  ],
  "title": "ExperimentConfig",
  "type": "object"
}